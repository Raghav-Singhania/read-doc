# Copy to .env and fill in. .env is gitignored; this file is not.

# Google Gemini API key. Used for BOTH embeddings (gemini-embedding-001)
# and answer generation (ChatGoogleGenerativeAI).
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Everything below is optional — app/config.py has working defaults.
# Uncomment only to override.

# Where uploaded PDFs and the Chroma database live.
# STORAGE_DIR=storage/documents
# CHROMA_DIR=storage/chroma

# Chunking. CHUNK_OVERLAP must be smaller than CHUNK_SIZE.
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200

# How many chunks to retrieve per question.
# RETRIEVAL_K=4

# Upload ceiling in bytes. Default 20 MiB.
# MAX_UPLOAD_BYTES=20971520
